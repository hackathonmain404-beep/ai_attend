# AttendGuard AI Module - Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or expose GEMINI_API_KEY to the client!

# Gemini API Key (obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
