# ==============================================================================
# ATTENDGUARD ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and configure your local credentials.
# NEVER commit .env.local to Git.
# ==============================================================================

# Application Base URL
# Scope: Public (Client & Server)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase API Endpoint
# Scope: Public (Client & Server)
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key
# Scope: Public (Client & Server)
# Safe to expose in browser. Protected by Row Level Security (RLS).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role Key
# Scope: SERVER-ONLY
# CRITICAL: Bypasses Row Level Security (RLS). NEVER expose to client bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Campus Network & IP Verification Configuration
# Scope: SERVER-ONLY
# Enable or disable campus IP checking (true / false)
IP_CHECK_ENABLED=true
# Policy for handling IP mismatches:
# - 'review': Attendance is recorded but flagged for teacher review (default & recommended)
# - 'reject': Strict denial; attendance is rejected if client IP is not on the allowlist
IP_MISMATCH_POLICY=review
# Comma-separated list of approved campus public IP addresses or CIDR ranges.
# Real campus IPs must be provided by the institution network administrator.
# Examples: 198.51.100.1, 203.0.113.0/24, 2001:db8::/32, 127.0.0.1, ::1
CAMPUS_IP_ALLOWLIST=127.0.0.1, ::1, 192.168.1.0/24

# Reverse Proxy Security Configuration
# Scope: SERVER-ONLY
# Set to 'true' if operating behind trusted reverse proxies (e.g., Vercel, Cloudflare, NGINX)
TRUST_PROXY=true
# Number of trusted upstream proxies in front of the application
TRUSTED_PROXY_COUNT=1

# Optional Campus Geolocation Reference (Untrusted supporting signal)
# Scope: SERVER-ONLY
CAMPUS_LAT=37.7749
CAMPUS_LON=-122.4194
CAMPUS_RADIUS_METERS=150

# Cryptographic QR HMAC Secret
# Scope: SERVER-ONLY
# Minimum 32-character high-entropy secret string used to sign dynamic QR challenges.
QR_HMAC_SECRET=replace_with_a_secure_random_32_character_string_minimum

# Dynamic QR Challenge Expiry Window (Seconds)
# Scope: SERVER-ONLY
QR_TOKEN_TTL_SECONDS=20

# Gemini API Configuration (Google GenAI SDK)
# Scope: SERVER-ONLY (NEVER expose to client!)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alternative AI Inference Configuration (e.g., Groq / OpenAI compatible)
# Scope: SERVER-ONLY
AI_INFERENCE_BASE_URL=https://api.groq.com/openai/v1
AI_INFERENCE_API_KEY=gsk_your_groq_api_key_here
AI_MODEL_NAME=llama-3.1-8b-instant

