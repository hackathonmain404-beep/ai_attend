# ==============================================================================
# ATTENDGUARD ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and configure your local credentials.
# NEVER commit .env.local to Git.
# ==============================================================================

# Application Base URL
# Scope: Public (Client & Server)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase API Endpoint
# Scope: Public (Client & Server)
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key
# Scope: Public (Client & Server)
# Safe to expose in browser. Protected by Row Level Security (RLS).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role Key
# Scope: SERVER-ONLY
# CRITICAL: Bypasses Row Level Security (RLS). NEVER expose to client bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Campus Network & IP Verification Configuration
# Scope: SERVER-ONLY
# Enable or disable campus IP checking (true / false)
IP_CHECK_ENABLED=true
# Policy for handling IP mismatches:
# - 'review': Attendance is recorded but flagged for teacher review (default & recommended)
# - 'reject': Strict denial; attendance is rejected if client IP is not on the allowlist
IP_MISMATCH_POLICY=review

# Policy for handling browser profile / device fingerprint mismatches:
# - 'review': Attendance is recorded but flagged with status 'review_required' for teacher review
#             (avoids locking out students solely because ordinary browser attributes changed)
# - 'reject': Strict denial; attendance is rejected with 403 DEVICE_MISMATCH if fingerprint does not match
DEVICE_MISMATCH_POLICY=review
# Comma-separated list of approved campus public IP addresses or CIDR ranges.
# NOTE: The default values below (127.0.0.1, ::1) are strictly for local loopback development.
# Institutional production deployment MUST ONLY use authoritative public IPv4/IPv6 CIDR blocks
# officially provided by the college's network administrator. Documentation ranges (e.g. RFC 5737
# 203.0.113.0/24) and private RFC 1918 subnets must not be configured as public campus ranges.
CAMPUS_IP_ALLOWLIST=127.0.0.1, ::1


# Reverse Proxy Security Configuration
# Scope: SERVER-ONLY
# Set to 'true' if operating behind trusted reverse proxies (e.g., Vercel, Cloudflare, NGINX)
TRUST_PROXY=true
# Number of trusted upstream proxies in front of the application
TRUSTED_PROXY_COUNT=1

# Optional Campus Geolocation Reference (Untrusted supporting signal)
# Scope: SERVER-ONLY
CAMPUS_LAT=37.7749
CAMPUS_LON=-122.4194
CAMPUS_RADIUS_METERS=150

# Cryptographic QR HMAC Secret
# Scope: SERVER-ONLY
# Minimum 32-character high-entropy secret string used to sign dynamic QR challenges.
QR_HMAC_SECRET=replace_with_a_secure_random_32_character_string_minimum

# Dynamic QR Challenge Expiry Window (Seconds)
# Scope: SERVER-ONLY
QR_TOKEN_TTL_SECONDS=20

# WebAuthn / Passkey Biometric Verification Configuration
# Scope: SERVER-ONLY
# Human-readable relying party name displayed in device authenticator prompt
WEBAUTHN_RP_NAME=AttendGuard
# Relying Party Identifier: must match deployment hostname (e.g. localhost, attendguard.edu)
WEBAUTHN_RP_ID=localhost
# Exact origin allowed for WebAuthn ceremony (e.g. http://localhost:3000, https://attendguard.edu)
# In production, this MUST use HTTPS and match the authoritative institutional domain
WEBAUTHN_ORIGIN=http://localhost:3000
# Challenge TTL in seconds (default: 120s)
WEBAUTHN_CHALLENGE_TTL_SECONDS=120
# Institutional WebAuthn enforcement policy:
# - 'required': Passkey enrollment is mandatory; unregistered accounts cannot check in (default & required for production)
# - 'optional': Enrolled passkeys are strictly enforced; unregistered accounts use registered device fallback
WEBAUTHN_ENFORCEMENT_POLICY=required

# Gemini API Configuration (Google GenAI SDK)
# Scope: SERVER-ONLY (NEVER expose to client!)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alternative AI Inference Configuration (e.g., Groq / OpenAI compatible)
# Scope: SERVER-ONLY
AI_INFERENCE_BASE_URL=https://api.groq.com/openai/v1
AI_INFERENCE_API_KEY=gsk_your_groq_api_key_here
AI_MODEL_NAME=llama-3.1-8b-instant

# Custom Camera Face Attendance Feature Flag
# Scope: SERVER-ONLY
# Strict security policy: Custom camera facial-recognition attendance MUST default to disabled
# in production until face-matching accuracy, illumination invariance, and anti-spoofing certification
# are fully validated. Standard dynamic QR + WebAuthn passkey check-in remains the authoritative path.
ENABLE_FACE_ATTENDANCE=false

# Biometric Template AES-256-GCM Encryption Key
# Scope: SERVER-ONLY (CRITICAL INSTITUTIONAL SECRET)
# Required when custom biometric template storage is enabled. Must be exactly 64 hexadecimal
# characters representing 32 random bytes (256-bit AES key). Passphrases are NOT supported.
#
# Key Generation:
#   Generate a cryptographically secure 256-bit key via OpenSSL CLI:
#   $ openssl rand -hex 32
#
# Key Management & Operational Lifecycle:
# - Generation: Use a cryptographically secure random number generator (CSPRNG).
# - Storage: Store exclusively in encrypted server environment variables (e.g., AWS Secrets Manager,
#   Vercel Encrypted Environment Variables, HashiCorp Vault). Never commit or expose to client code.
# - Backup: Securely escrow the key in encrypted, air-gapped configuration backups. Loss of this key
#   renders all stored biometric templates permanently undecryptable.
# - Rotation / Migration: Ordinary application requests NEVER fall back to legacy keys. If pre-existing
#   records need migration, an authorized administrator must explicitly execute the offline migration tool
#   (src/modules/biometrics/tools/key-migration.ts) during a scheduled maintenance window.
BIOMETRIC_ENCRYPTION_KEY=replace_with_64_character_hex_key_generated_via_openssl_rand_hex_32

